<!DOCTYPE html>
<html lang=“th”>
<head>
<meta charset=“UTF-8”>
<meta name=“viewport” content=“width=device-width, initial-scale=1.0”>
<title>ถึงคนเก่า ❤️</title>

<style>
body{
  margin:0;
  font-family:sans-serif;
  background:linear-gradient(135deg,#ffd6e7,#dff7ff);
  display:flex;
  justify-content:center;
  align-items:center;
  height:100vh;
}

.card{
  width:320px;
  background:white;
  border-radius:20px;
  padding:20px;
  text-align:center;
  box-shadow:0 10px 30px rgba(0,0,0,.15);
}h1{color:#ff5c8a;}
button{
  background:#ff8fb1;
  color:white;
  border:none;
  padding:12px 25px;
  border-radius:30px;
  font-size:16px;
}
</style>
</head>

<body>

<div class=“card”>
  <h1>💗 ถึงคนเก่า</h1>
  <p id=“text”> มีเรื่องหนึ่งที่เราอยากบอก...</p>
  <button onclick=“nextPage()”>ถัดไป</button>
</div>

<script>
const msg=[
“มีเรื่องหนึ่งที่เราอยากบอก...”,
“อยากให้เราสองคนมีโอกาสมานั่งคุยกัน”,
“แบบให้รู้เรื่องทั้งสองเข้าใจกัน”,
“ละขอโทดกับทุกเรื่องที่เคยทำไม่ดีด้วย”,
"ทั้งคำพูดละการกระทำขอโทดด้วย",
"ขอบคุณทุกอย่างที่เคยทำให้",
];

let i=0;

function nextPage(){
  i++;
  if(i<msg.length){document.getElementById(“text”).innerText=msg[i];
  }else{
    document.body.innerHTML=
    “<h1 style=‘font-family:sans-serif;text-align:center;color:#ff4f8b’> ขอให้โชคดี 💕</h1>”;
  }
}
</script>

</body>
</html>
